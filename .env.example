# MySQL Database Connection String
# Example: mysql://username:password@hostname:3306/database_name
DATABASE_URL="mysql://root:password@127.0.0.1:3306/leadflow"

# Tenant JWT Secret Key
JWT_SECRET="leadflow_super_secret_jwt_key_2026_production_change_this"

# Platform Super Admin JWT Secret Key (Isolated from tenant secret)
ADMIN_JWT_SECRET="leadflow_super_admin_secret_key_2026_separate_auth_change_this"

# Node Environment
NODE_ENV="development"
