datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum BusinessType {
  REAL_ESTATE
  AUTOMOBILE
  INSURANCE
  INTERIOR_DESIGN
  LOAN_FINANCE
  SOLAR
  PHOTOGRAPHY
  EDUCATION
  OTHER
}

enum BusinessStatus {
  ACTIVE
  SUSPENDED
}

enum LeadStatus {
  NEW
  CONTACTED
  INTERESTED
  FOLLOW_UP
  SITE_VISIT
  CONVERTED
  LOST
}

enum FollowUpStatus {
  PENDING
  DONE
  CANCELLED
}

model SuperAdmin {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Business {
  id                 Int            @id @default(autoincrement())
  name               String
  phone              String?
  email              String?
  address            String?
  businessType       BusinessType   @default(OTHER)
  status             BusinessStatus @default(ACTIVE)
  plan               String         @default("FREE")
  field1Label        String?
  field2Label        String?
  field3Label        String?
  field4Label        String?
  defaultCountryCode String?        @default("91")
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  users              User[]
  leads              Lead[]
  notifications      Notification[]
  emailMessages      EmailMessage[]
  loginLogs          LoginLog[]
  fieldVisits        FieldVisit[]

  @@index([status])
}

model User {
  id              Int            @id @default(autoincrement())
  businessId      Int
  name            String
  email           String         @unique
  phone           String?
  avatarUrl       String?        @db.MediumText
  role            String         @default("ADMIN") // "ADMIN" | "AGENT"
  canAddLeads     Boolean        @default(true)
  canViewAllLeads Boolean        @default(true)
  passwordHash    String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  business        Business       @relation(fields: [businessId], references: [id])
  leads           Lead[]
  followUps       FollowUp[]
  activities      LeadActivity[]
  notifications   Notification[]
  loginLogs       LoginLog[]
  attendances     Attendance[]
  workProofs      WorkProof[]
  fieldVisits     FieldVisit[]

  @@index([businessId])
}

model Attendance {
  id              Int       @id @default(autoincrement())
  userId          Int
  businessId      Int
  date            String    // YYYY-MM-DD
  sodTime         DateTime?
  sodSelfieUrl    String?   @db.MediumText
  sodLat          Float?
  sodLng          Float?
  sodLocationName String?
  eodTime         DateTime?
  eodSelfieUrl    String?   @db.MediumText
  eodLat          Float?
  eodLng          Float?
  eodLocationName String?
  eodSummary      String?   @db.Text
  status          String    @default("CLOCKED_IN") // "CLOCKED_IN" | "CLOCKED_OUT"
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id])

  @@index([userId, date])
  @@index([businessId, date])
}

model WorkProof {
  id           Int      @id @default(autoincrement())
  userId       Int
  businessId   Int
  leadId       Int?
  title        String
  description  String?  @db.Text
  imageUrl     String?  @db.MediumText
  audioUrl     String?  @db.MediumText
  latitude     Float?
  longitude    Float?
  locationName String?
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([businessId])
  @@index([leadId])
}

model LoginLog {
  id         Int      @id @default(autoincrement())
  userId     Int?
  businessId Int?
  email      String
  success    Boolean
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  business   Business? @relation(fields: [businessId], references: [id])
  user       User?     @relation(fields: [userId], references: [id])

  @@index([businessId])
  @@index([userId])
  @@index([createdAt])
  @@index([email])
}

model Lead {
  id             Int        @id @default(autoincrement())
  businessId     Int
  assignedUserId Int?

  name           String
  phone          String
  email          String?
  alternatePhone String?

  source         String?
  status         LeadStatus @default(NEW)

  field1Label    String?
  field1Value    String?
  field2Label    String?
  field2Value    String?
  field3Label    String?
  field3Value    String?
  field4Label    String?
  field4Value    String?

  notes          String?
  nextFollowupAt DateTime?

  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  business       Business       @relation(fields: [businessId], references: [id])
  assignedUser   User?          @relation(fields: [assignedUserId], references: [id])
  followUps      FollowUp[]
  activities     LeadActivity[]
  emailMessages  EmailMessage[]
  fieldVisits    FieldVisit[]

  @@index([businessId])
  @@index([phone])
  @@index([status])
  @@index([nextFollowupAt])
  @@index([businessId, phone]) // for duplicate-detection lookups
}

model FieldVisit {
  id               Int       @id @default(autoincrement())
  businessId       Int
  userId           Int
  leadId           Int?
  clientName       String
  clientPhone      String?
  purpose          String    // "Site Visit", "Client Meeting", "Payment Collection", "Document Verification", "Demo / Pitch", "Other"
  
  // Check-In Details
  checkInTime      DateTime  @default(now())
  checkInLat       Float?
  checkInLng       Float?
  checkInLocation  String?
  checkInPhotoUrl  String?   @db.MediumText

  // Check-Out Details
  checkOutTime     DateTime?
  checkOutLat      Float?
  checkOutLng      Float?
  checkOutLocation String?
  checkOutPhotoUrl String?   @db.MediumText
  
  // Meeting Outcome
  durationMinutes  Int?
  outcome          String?   // "INTERESTED", "DEAL_CLOSED", "NEEDS_FOLLOW_UP", "NOT_INTERESTED", "RESCHEDULED"
  notes            String?   @db.Text
  amountCollected  Float?
  status           String    @default("IN_PROGRESS") // "IN_PROGRESS" | "COMPLETED" | "CANCELLED"
  
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  business         Business  @relation(fields: [businessId], references: [id])
  user             User      @relation(fields: [userId], references: [id])
  lead             Lead?     @relation(fields: [leadId], references: [id])

  @@index([businessId, createdAt])
  @@index([userId, createdAt])
  @@index([leadId])
}

model FollowUp {
  id          Int            @id @default(autoincrement())
  leadId      Int
  userId      Int
  scheduledAt DateTime
  status      FollowUpStatus @default(PENDING)
  note        String?
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  lead        Lead @relation(fields: [leadId], references: [id])
  user        User @relation(fields: [userId], references: [id])

  @@index([leadId])
  @@index([scheduledAt])
}

model LeadActivity {
  id          Int      @id @default(autoincrement())
  leadId      Int
  userId      Int
  type        String   // "CALL" | "WHATSAPP" | "EMAIL" | "STATUS_CHANGE" | "NOTE" | "LEAD_CREATED"
  description String
  createdAt   DateTime @default(now())

  lead        Lead @relation(fields: [leadId], references: [id])
  user        User @relation(fields: [userId], references: [id])

  @@index([leadId])
}

model Notification {
  id         Int      @id @default(autoincrement())
  businessId Int
  userId     Int
  title      String
  message    String
  type       String   // "FOLLOW_UP" | "EMAIL" | "LEAD" | "SYSTEM"
  link       String?
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  business   Business @relation(fields: [businessId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@index([businessId, userId])
  @@index([read])
}

model EmailMessage {
  id         Int      @id @default(autoincrement())
  businessId Int
  leadId     Int?
  fromEmail  String
  fromName   String?
  toEmail    String
  subject    String
  body       String
  direction  String   @default("INBOUND") // "INBOUND" | "OUTBOUND"
  status     String   @default("UNREAD")  // "UNREAD" | "READ" | "REPLIED"
  createdAt  DateTime @default(now())

  business   Business @relation(fields: [businessId], references: [id])
  lead       Lead?    @relation(fields: [leadId], references: [id])

  @@index([businessId])
  @@index([status])
}

model ReminderLog {
  id         Int      @id @default(autoincrement())
  businessId Int
  sentAt     DateTime @default(now())
  channel    String   // "WHATSAPP" | "SMS"
  status     String   // "SENT" | "FAILED"
}
